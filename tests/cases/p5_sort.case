# more than one run, with small pieces
$ seq 1 20000 | sort | head -3
$ seq 1 20000 | sort | tail -3
$ seq 1 20000 | sort | wc
$ seq 1 20000 | sort -rn | sed -n '1p;10000p;$p'
$ seq 1 20000 | sort -u | wc -l
$ seq 1 9000 > a; seq 1 9000 >> a; sort -u a | wc -l
$ seq 1 9000 > a; seq 1 9000 >> a; sort -n a | uniq -c | sort -u -k1,1 
$ seq 1 9000 > a; seq 1 9000 >> a; sort -k1.2 a | sed -n '1p;777p;$p'
