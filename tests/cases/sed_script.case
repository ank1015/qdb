# Stage 4, part 3: sed options, addresses, commands and blocks.
@fixture basic

# options
$ sed -n p notes.txt
$ sed -n 2p notes.txt
$ sed -n -e 1p -e 3p notes.txt
$ sed -e 1d -e 's/note/NOTE/' notes.txt
$ sed -e1d notes.txt
$ sed -ne 2p notes.txt
$ sed -r 's/(o+)/[\1]/' notes.txt
$ sed -E 's/(o+)/[\1]/' notes.txt
$ sed -s -n '$p' notes.txt README.md
$ sed -n '$p' notes.txt README.md
$ sed -s -n 1p notes.txt README.md
$ sed -n 1p notes.txt README.md
$ sed -s '2,/zzz/d' notes.txt README.md
$ sed -n -s '$=' notes.txt README.md
$ sed -n '$=' notes.txt README.md
$ sed -n '$=' README.md notes.txt
$ sed -e
$ sed -n
$ sed
$ sed -n -e p -- notes.txt
$ sed -- p notes.txt
$ sed p - < notes.txt
$ sed p README.md - < notes.txt
$ sed p nope notes.txt
$ sed -n '$p' notes.txt nope
$ sed -n '$p' nope README.md
$ sed -n '$p' README.md empty/nothing
$ sed p src
$ sed p notes.txt src README.md
$ sed -i p src
$ sed -n -i p
$ sed -i p nope notes.txt
+ cat notes.txt
$ sed -i.bak 's/note/N/' notes.txt
+ cat notes.txt notes.txt.bak
+ ls
$ sed -i.bak 's/note/N/' notes.txt README.md
+ ls
$ sed -ibak 2d notes.txt
+ cat notes.txtbak notes.txt
$ sed -i.orig 's/zzz/y/' src/util.c
+ ls src
$ sed -ni.o 2p notes.txt
+ cat notes.txt notes.txt.o
$ sed -in 2p notes.txt
+ ls
+ cat notes.txt
$ sed -i.bak 1d notes.txt; sed -i.bak 1d notes.txt
+ cat notes.txt.bak notes.txt
$ sed -n -i 2p notes.txt
+ cat notes.txt
$ sed -i -n '$p;1p' notes.txt README.md
+ cat notes.txt README.md
$ sed -i '$d' notes.txt README.md
+ cat notes.txt README.md
$ sed -i 2q README.md
+ cat README.md
$ sed -i 2Q README.md notes.txt
+ cat README.md notes.txt
$ sed -i '2q5' README.md notes.txt
+ cat README.md notes.txt
$ sed -i 1d empty/nothing
+ cat empty/nothing
$ sed -i -e 1d -e '$d' README.md
+ cat README.md
$ sed -i '1i\top' notes.txt
+ cat notes.txt
$ sed -i '$a END' notes.txt
+ cat notes.txt
$ sed -i 'y/aeiou/AEIOU/' docs/guide.md
+ cat docs/guide.md
$ sed -i '/TODO/d' README.md src/main.c src/util.c
+ grep -rc TODO .
$ sed -i -n '/TODO/p' README.md src/main.c
+ cat README.md src/main.c
$ sed -i '2,3s/^/> /' README.md
+ cat README.md
$ sed -i '1~2d' data/numbers.txt
+ cat data/numbers.txt
$ sed -i '/^$/d' README.md
+ cat README.md
$ sed -i '2c\changed' README.md
+ cat README.md
$ sed -i = notes.txt
+ cat notes.txt
! sed -i'bk_*' 2d notes.txt ## backup suffix
! sed -i.b/x 2d notes.txt ## backup suffix
! sed --quiet p notes.txt ## long options
! sed --expression=p notes.txt ## long options
! sed -z p notes.txt ## sed -z
! sed -f script notes.txt ## sed -f
! sed -u p notes.txt ## sed -u
! sed -l 5 p notes.txt ## sed -l

