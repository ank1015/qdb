$ echo ,{a,b},
$ echo {a,,b}
$ echo x{a,,b}y
$ echo {0..0}
$ echo {-1..-3}
$ echo {+1..3}
$ echo {1..+3}
$ echo {9..11}
$ echo {09..11}
$ echo {a,b}=c
$ echo {x..z}{1..2}
! echo ${a,b} ## parameter expansion

# Line continuation.
$ echo one \⏎two
$ echo one\⏎two
$ echo "one\⏎two"
$ echo 'one\⏎two'
$ ls \⏎src
$ ls | \⏎wc -l
$ ls |⏎wc -l
$ echo a && \⏎echo b
$ ec\⏎ho split
$ cat README.md \⏎  | head -n 1 \⏎  | wc -c
$ echo a \⏎ > out.txt; cat out.txt

# Still refused by name, inside a longer unit too: nothing runs.
! echo one > made.txt; cd - ## cd -
! echo one > made.txt && awk 1 ## command: awk
! echo one > made.txt; ls --frobnicate ## flag: ls --frobnicate
! rm README.md; for f; do ls; done ## for loop without `in'
! rm README.md⏎if ls; then ls --frobnicate; fi ## flag: ls --frobnicate
! rm README.md; x+=1 ## variable assignment
! rm README.md; echo ${x^^} ## parameter expansion
! rm README.md; while false; do awk 1; done ## command: awk
! rm README.md; for f in $(ls --frobnicate); do ls; done ## flag: ls --frobnicate
! rm README.md; echo ${x:-$(awk 1)} ## command: awk
! rm README.md; echo $(( $(awk 1) + 1 )) ## command: awk
! rm README.md; ( ls ) ## subshell
! rm README.md; { ls; } ## group command
$ rm README.md; ! ls; echo $?
! rm README.md; ls ~root ## tilde expansion
! rm README.md; [[ -f x ]] ## [[ conditional ]]
! rm README.md; ls & ## background jobs
! rm README.md; cat <(ls) ## process substitution
! rm README.md; ls ) ## syntax error
! rm README.md; echo 'open ## matching `''
