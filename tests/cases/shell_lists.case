$ echo {a,b} > out.txt; cat out.txt
$ ls > {a,b}
$ echo {a,b}$(echo c)
$ echo $(echo x){a,b}
$ echo {1..3} | wc -w
$ echo a{b,c}d{e,f}g{h,i}
