$ echo {a,b}
$ echo {a,b,c}
$ echo x{a,b}y
$ echo {a,b}{c,d}
$ echo {a,{b,c}}
$ echo {a,{b,{c,d}}}e
$ echo a{,b}
$ echo a{b,}
$ echo {,}
$ echo a{,}b
$ echo {a,b}{,}
$ echo {1..3}
$ echo {3..1}
$ echo {1..10..3}
$ echo {10..1..3}
