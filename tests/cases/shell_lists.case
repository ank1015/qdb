$ echo {a,b}/README.md
$ echo src/{main,util}.c
$ cat src/{main,util}.c | wc -l
$ ls src/lib/{lex,parse}.c
$ ls {src,empty}
$ ls {src,nope}
$ echo {src,empty}/*
$ echo *.{md,txt}
$ echo *.{md,zzz}
$ mkdir -p x/{a,b}/{c,d}; find x
