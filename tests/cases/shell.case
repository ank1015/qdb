# The shell layer: quoting, globs, pipes, redirection, and everything
# that must be rejected by name.
@fixture basic

# Paths: no current directory, everything resolves from the root.
$ cat README.md | wc -c
$ cat ./README.md | wc -c
$ cat .//README.md | wc -c
$ cat src/../README.md | wc -c
$ cat src/./lib/../../README.md | wc -c
$ cat {ROOT}/README.md | wc -c
$ cat {ROOT}/src/../README.md | wc -c
= cat /README.md | wc -c
> 104
= cat ../README.md | wc -c
> 104
= cat /../../README.md | wc -c
> 104
= ls /src/lib
> lex.c
> lex.h
> parse.c
= ls ..
> Makefile
> README.md
> data
> deep
> docs
> empty
> notes.txt
> src
> with space.txt
= find /src/lib -name '*.h'
> /src/lib/lex.h
= grep -rl TODO /src
> /src/lib/lex.c
> /src/main.c
= echo hi > /top.txt
+= cat top.txt ./top.txt /top.txt
> hi
> hi
> hi

