$ sed -i 's/int/long/g' src/*.c src/lib/*.c
+ grep -rc long src
$ sed -i -E 's/(add|sub)\(/my_\1(/g' src/util.c src/util.h src/main.c
+ cat src/util.h
+ grep -rn my_ src
$ sed -E -i 's/[0-9]+/N/' data/numbers.txt
+ head -n 3 data/numbers.txt
$ sed -iE 's/1/x/' data/numbers.txt
