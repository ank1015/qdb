$ sed -i 's/note/NOTE/' notes.txt
+ cat notes.txt
$ sed -i 's/note/NOTE/g' notes.txt
+ cat notes.txt
+ wc notes.txt
$ sed -i 's/TODO/DONE/' README.md
+ grep -n DONE README.md
