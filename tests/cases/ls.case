# ls with -a, -R, -1, -p
@fixture basic
$ ls
$ ls -1
$ ls -a
$ ls -p
$ ls -ap
$ ls -R
$ ls -aR
$ ls -pR
$ ls -a1pR
$ ls -a -R -p -1
