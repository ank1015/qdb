$ test a b c
$ test a b c d
$ test a = a b
$ test a = a -a
$ test -f
$ test -f -a -d
$ test '(' a
$ test '(' a = a
$ test 1 -eq 1 -a 2 -eq 2 -a 3 -eq 4
$ test -z '' -a -n x -o -f nope
$ test -n = -n
$ test -f = -f
$ test = = =
$ test ! ! a
$ test ! ! ''
$ test -a
$ test -o
$ test ! 
$ test '!' = '!'
$ test -n a -a ! -z b
$ [ a = a ]
$ [ a = b ]
$ [ -f README.md ]
$ [ -d src ] && echo dir
$ [ -f nope ] || echo missing
$ [ ]
$ [ a
$ [
$ [ a = a
$ [ ] ]
$ [ 1 -lt 2 -a 2 -lt 3 ]
$ [ ! -e nope ] && echo none
$ [ "$(cat data/one.txt)" = one ] && echo same
$ [ -n "$(grep -r TODO src)" ] && echo found
$ [ -z "$(grep -r nothinghere src)" ] && echo empty
$ [ $(wc -l < README.md) -gt 3 ] && echo long
$ test -f README.md && test -d src && echo both
$ test -f nope; test -d src
$ test a = b || test c = c && echo ok
! test -r README.md ## test -r
! test -w README.md ## test -w
! test -x README.md ## test -x
! test -L README.md ## test -L
! test README.md -nt notes.txt ## test -nt
! [ -r README.md ] ## [ -r

# true, false, :
$ true
$ false
$ :
$ true ignored args
$ false ignored args
$ : ignored args
$ true && echo yes
$ false || echo no
$ false && echo never
$ true || echo never
$ : > made.txt; ls
$ true | false
$ false | true
$ false; true
$ true; false
$ find . -type f -name '*.md' -exec true \;
$ find . -type f -name '*.md' -exec false \;

# sleep
$ sleep 0
$ sleep 0.01
$ sleep 0 0
$ sleep 0s
$ sleep 0m 0h 0d
$ sleep
$ sleep x
$ sleep 1x
$ sleep -1
$ sleep ''
$ sleep 0 x 0 y
$ sleep 0 && echo woke

# basename
