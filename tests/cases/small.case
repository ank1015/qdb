$ basename -s.c src/main.c
$ basename --suffix=.c src/main.c src/util.c
$ basename --multiple a/b c/d
$ basename -s
$ basename -z a/b | cat -A
$ basename -- -x
$ basename 'with space.txt' .txt
$ basename "$(find src -name lex.c)"
$ find src -name '*.c' -exec basename {} .c \;
! basename -q a ## basename -q

