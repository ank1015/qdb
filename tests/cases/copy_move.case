$ mv src docs empty
+ ls -p . empty
$ mv src README.md
$ mv src README.md/
$ mv src docs README.md
$ mv src nope/x
$ mv src src
$ mv src src/
$ mv src src/lib
$ mv src src/lib/
$ mv src src/new
$ mv src src/lib/new
$ mv src/lib src
$ mv src/lib src/
$ mv deep/a/b/c deep
+ find deep
$ mv deep/a/b deep/a/b/c
$ mv empty deep/a/b/hollow
+ find deep -type d
$ mv empty deep/a/b
+ find deep -type d
$ mkdir -p t/src
+ mv src t
+ ls -R t
+ ls -p
$ mkdir -p t/src/x
+ mv src t
+ ls -p . t
$ mkdir -p t
+ touch t/src
+ mv src t
+ ls -p . t
$ mkdir -p t/README.md
+ mv README.md t
+ ls -p . t
$ mv README.md empty/../moved.md
+ ls
$ mv data/blank.txt data/one.txt
+ wc -c data/one.txt
+ ls data
$ mv 'with space.txt' 'still spaced.txt'
+ ls
$ mv with\ space.txt nospace.txt
+ ls
$ mv .hidden visible
+ ls -a
$ mv README.md .README
+ ls -a
$ mv empty README.md
$ mv README.md empty/README.md
+ ls . empty
$ mv docs/guide.md docs/api.md src
+ ls docs src
$ mv src/main.c src/util.c src/lib/
+ ls src src/lib
$ mv . x
$ mv src/. x
$ mv README.md ''
$ mv '' x
$ mv {ROOT}/README.md {ROOT}/abs.md
+ ls
! mv -n README.md x ## mv -n
! mv -f README.md x ## mv -f
! mv -v README.md x ## mv -v
! mv -i README.md x ## mv -i
! mv -t src README.md ## mv -t
! mv --force README.md x ## long options
